<?xml version="1.0" encoding="utf-8"?>
<!-- 本次美化新增：颜色选择浮层（白色圆角 + 细描边 + 投影） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="2dp"
        android:right="2dp"
        android:top="6dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#22101423" />
            <corners android:radius="20dp" />
        </shape>
    </item>
    <item
        android:top="0dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="20dp" />
            <stroke
                android:width="1dp"
                android:color="#E7ECF3" />
        </shape>
    </item>
</layer-list>
