<?xml version="1.0" encoding="utf-8"?>
<!-- 本次美化新增：主操作按钮按下态（颜色加深） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="4dp"
        android:right="4dp"
        android:top="6dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <solid android:color="#2A148F86" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="6dp">
        <shape android:shape="rectangle">
            <gradient
                android:angle="0"
                android:startColor="#1DBDAD"
                android:endColor="#0E9186" />
            <corners android:radius="30dp" />
        </shape>
    </item>
</layer-list>
